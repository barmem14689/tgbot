BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789,987654321

# Database
DATABASE_PATH=bot.db

# Subscription options shown in inline buttons (days)
SUBSCRIPTION_PERIODS=30,90,180,365
PRICE_PER_MONTH_RUB=150

# Grace period after expiration when old key can still be extended (days)
GRACE_PERIOD_DAYS=3
# Если true — оплаченные дни добавляются к текущей дате окончания (остаток + новый период).
# Если false (по умолчанию) — срок = N дней с момента подтверждения оплаты (как обычно ожидают при «купил месяц»).
EXTEND_PAID_FROM_CURRENT_END=false
# За сколько дней до окончания подписки показывать предупреждение на /start
SUB_EXPIRY_WARN_DAYS=7

# Cleanup worker interval
CLEANUP_INTERVAL_MINUTES=30

# X-UI panel (URL входа в веб-панель)
XUI_BASE_URL=https://your-panel.example.com/your-path/
XUI_USERNAME=admin
XUI_PASSWORD=your_password
XUI_INBOUND_ID=1

# X-UI PRO / 3x-ui API endpoints (defaults are most common).
# Available placeholders in endpoints: {client_id}, {inbound_id}, {sub_id}
XUI_LOGIN_ENDPOINT=/login
XUI_GET_INBOUND_ENDPOINT=/panel/api/inbounds/get/{inbound_id}
XUI_ADD_CLIENT_ENDPOINT=/panel/api/inbounds/addClient
XUI_UPDATE_CLIENT_ENDPOINT=/panel/api/inbounds/updateClient/{client_id}
XUI_DELETE_CLIENT_ENDPOINT=/panel/api/inbounds/delClient/{client_id}

# --- Ключи VLESS для пользователя (KEY_TEMPLATE) ---
# В шаблон подставляются только плейсхолдеры, которые реально есть в строке.
# Базовые: {uuid} {vpn_host} {vpn_port} {xui_email}
# XHTTP: {vless_path_q} {xhttp_mode}
# TLS (External Proxy в панели): {tls_sni} {xhttp_host}
# Reality: {reality_pbk} {reality_sid} {reality_sni} {reality_fp}
#
# ВАЖНО: в inbound «Порт: 1» — это внутренний порт за nginx. Клиент ходит на External Proxy:
# домен + 443 (как в строке TLS под inbound). В VPN_HOST / VPN_PORT указывайте именно их.

# Пример под ваши скрины: VLESS + XHTTP + TLS, External Proxy gaben.h4ck.me:443, Path /Hpcyk08OBc, mode packet-up
KEY_TEMPLATE=vless://{uuid}@{vpn_host}:{vpn_port}?encryption=none&type=xhttp&security=tls&sni={tls_sni}&host={xhttp_host}&path={vless_path_q}&mode={xhttp_mode}#{xui_email}
VPN_HOST=gaben.h4ck.me
VPN_PORT=443
VLESS_XHTTP_PATH=/Hpcyk08OBc
VLESS_XHTTP_MODE=packet-up
# SNI/Host для TLS (если пусто — берётся VPN_HOST). В панели поле Host у XHTTP пустое — обычно = домену прокси.
VLESS_TLS_SNI=gaben.h4ck.me
VLESS_XHTTP_HOST=gaben.h4ck.me

# Если вместо TLS у вас Reality — замените KEY_TEMPLATE на вариант с security=reality и заполните:
# VLESS_REALITY_PBK=...
# VLESS_REALITY_SID=...
# VLESS_REALITY_SNI=...
# VLESS_REALITY_FP=chrome
# Пример строки:
# KEY_TEMPLATE=vless://{uuid}@{vpn_host}:{vpn_port}?encryption=none&type=xhttp&security=reality&pbk={reality_pbk}&fp={reality_fp}&sni={reality_sni}&sid={reality_sid}&path={vless_path_q}&mode={xhttp_mode}#{xui_email}
VLESS_REALITY_PBK=
VLESS_REALITY_SID=
VLESS_REALITY_SNI=
VLESS_REALITY_FP=chrome
